<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- 默认线：netstandard2.0 与 net10.0 使用 10.x 基础包 -->
  <PropertyGroup>
    <FastDFSMsExtVersion>[10.0.0,11.0.0)</FastDFSMsExtVersion>
  </PropertyGroup>

  <!-- net8.0：降到 8.x 线 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <FastDFSMsExtVersion>[8.0.0,9.0.0)</FastDFSMsExtVersion>
  </PropertyGroup>

  <!-- net9.0：使用 9.x 线 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <FastDFSMsExtVersion>[9.0.0,10.0.0)</FastDFSMsExtVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- TFM 无关的核心依赖 -->
    <PackageVersion Include="System.Buffers" Version="4.6.1" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.0" />
  </ItemGroup>

  <!-- 基础包：按 TFM 选 10.x / 8.x / 9.x -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(FastDFSMsExtVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(FastDFSMsExtVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(FastDFSMsExtVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(FastDFSMsExtVersion)" />
  </ItemGroup>

  <!-- 测试与基准工具：TFM 无关 -->
  <ItemGroup>
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="FluentAssertions" Version="8.8.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>
</Project>
